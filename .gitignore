# Local .terraform directories
**/.terraform/*

# .tfstate files - chứa thông tin nhạy cảm về infrastructure
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (có thể chứa thông tin nhạy cảm)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan

# Backup files
*.backup
